{
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(PYTHONPATH=. python main.py*)",
      "Bash(PYTHONPATH=. python scripts/*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(python --version*)",
      "Bash(cat data/*)",
      "Bash(ls*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
